# Turso Database (libSQL)
# По умолчанию используется локальная SQLite-база через @libsql/client: file:local.db
# Для облачной Turso укажите libsql:// URL и токен, затем выполните: npm run db:push
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Google Gemini API (СТРОГО на сервере — никогда не добавляйте NEXT_PUBLIC_!)
GEMINI_API_KEY=

# Опционально: зафиксировать конкретную модель Gemini Flash.
# По умолчанию автовыбор доступной модели: gemini-3.8-flash -> gemini-3.6-flash -> gemini-3.5-flash -> gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.8-flash

# Groq API (резервный ИИ-провайдер, если ключ или модели Gemini недоступны — СТРОГО на сервере!)
# Получить ключ: https://console.groq.com/keys
GROQ_API_KEY=

# Опционально: зафиксировать модель Groq (по умолчанию автовыбор: llama-3.3-70b-versatile -> openai/gpt-oss-120b -> meta-llama/llama-4-scout-17b-16e-instruct -> llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.3-70b-versatile
